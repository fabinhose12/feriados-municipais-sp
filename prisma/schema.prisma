// Calendário de feriados municipais (SP) — Projeto de Extensão
// Valores de texto (String) são validados na aplicação:
//   escopo:   NACIONAL | ESTADUAL | MUNICIPAL
//   tipo:     FERIADO | PONTO_FACULTATIVO
//   tipoData: FIXA | MOVEL
//   status:   APROVADO | PENDENTE | REJEITADO   (moderação)
//   origem:   ADMIN | USUARIO
//   fonte.tipo: LEI | SITE_PREFEITURA | DIARIO_OFICIAL | OUTRO
//   user.role: USER | ADMIN

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Municipio {
  id         Int       @id @default(autoincrement())
  nome       String    @unique
  codigoIbge String?   @unique
  regiao     String    // ABC | GRANDE_SP | CAMPINAS | OUTRA
  ativo      Boolean   @default(true)
  status     String    @default("APROVADO")
  feriados   Feriado[]
}

model Feriado {
  id           Int        @id @default(autoincrement())
  escopo       String     // NACIONAL | ESTADUAL | MUNICIPAL
  tipo         String     @default("FERIADO") // FERIADO | PONTO_FACULTATIVO
  nome         String
  tipoData     String     // FIXA | MOVEL
  mes          Int?       // 1-12 (quando FIXA)
  dia          Int?       // 1-31 (quando FIXA)
  offsetPascoa Int?       // dias em relação à Páscoa (quando MOVEL). Ex.: Sexta-feira Santa = -2
  vigenciaDe   Int?       // ano inicial (opcional)
  vigenciaAte  Int?       // ano final (opcional)
  verificado   Boolean    @default(false)
  status       String     @default("APROVADO")
  origem       String     @default("ADMIN")
  observacao   String?
  municipioId  Int?       // vazio para NACIONAL/ESTADUAL
  municipio    Municipio? @relation(fields: [municipioId], references: [id])
  autorId      String?    // quem enviou (vazio para dados do administrador)
  autor        User?      @relation(fields: [autorId], references: [id], onDelete: SetNull)
  fontes       Fonte[]
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt

  @@index([municipioId, mes, dia])
  @@index([status])
  @@index([autorId])
}

model Fonte {
  id           Int      @id @default(autoincrement())
  feriadoId    Int
  feriado      Feriado  @relation(fields: [feriadoId], references: [id], onDelete: Cascade)
  tipo         String   // LEI | SITE_PREFEITURA | DIARIO_OFICIAL | OUTRO
  referencia   String?  // ex.: número da lei
  url          String?
  consultadoEm DateTime
}

// ---------- Contas (Better Auth) ----------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  role          String    @default("USER")
  bloqueado     Boolean   @default(false)
  sessions      Session[]
  accounts      Account[]
  feriados      Feriado[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}